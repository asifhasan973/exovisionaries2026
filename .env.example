# ==============================================================================
# Exovisionaries 2026 - Environment Configuration Example
# Copy this file to .env or .env.local to customize local development settings.
# ==============================================================================

# Application Environment: 'development' allows in-app debug routes (#/debug/...) and toolbar; 'production' disables them.
VITE_APP_ENV=development

# Multiplier mechanism to simulate weak network conditions by slowing down
# progress bar loading X times (default: 1 = normal speed; e.g. 2, 3, or 5)
VITE_LOADING_PROGRESS_MULTIPLIER=1

# Minimum viewing duration for each carousel slide in milliseconds (default: 2800)
VITE_SLIDE_DISPLAY_MIN_MS=2800

# Pitch-black intro splash screen ("ExoVisionaries-2k26 Presents") duration in milliseconds (default: 2800)
VITE_INTRO_SPLASH_DISPLAY_MS=2800
